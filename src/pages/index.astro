    <section class="win gh" id="wGit" aria-label="GitHub">
      <span class="t">GitHub · <b>@Almo7aya</b></span><span class="r" id="ghLive">cached</span>
      <a class="big" href="https://github.com/Almo7aya">github.com/Almo7aya</a>
      <p class="stats"><b id="ghRepos">232</b> repos · <b id="ghFol">172</b> followers · since <b id="ghSince">2016</b></p>
      <ul>
        <li><a href="https://github.com/Almo7aya/openingh.nvim">openingh.nvim</a><span>★ <b id="ghS1">163</b></span></li>
        <li><a href="https://github.com/KytyPS5/KytyPS5">KytyPS5</a><span>contributor</span></li>
        <li><a href="https://github.com/Almo7aya/neogruvbox.nvim">neogruvbox.nvim</a><span>★ <b id="ghS2">30</b></span></li>
      </ul>
    </section>

    <section class="win" id="wData" aria-label="Memory">
      <span class="t">Memory · <b id="memAt">CS:IP</b></span><span class="r" id="memInfo">writes flash</span>
      <form class="memctl" id="memForm" autocomplete="off">
        <input id="memAddr" value="CS:IP" spellcheck="false" aria-label="address: seg:off, a linear address, or CS:IP / SS:SP">
        <span class="presets">
          <button type="button" data-at="CS:IP">CS:IP</button><button type="button" data-at="SS:SP">SS:SP</button><button type="button" data-at="0000:0000">IVT</button><button type="button" data-at="0040:0000">BDA</button><button type="button" data-at="B800:0000">B800</button><button type="button" data-at="A000:0000">A000</button><button type="button" data-at="0000:7C00">7C00</button><button type="button" data-at="F000:FFF0">ROM</button>
        </span>
      </form>
      <div class="scroll data" id="data"></div>
      <div class="img">
        <p>a real disk image (<span id="imgSize">…</span> bytes). boot it anywhere:</p>
        <p><code id="qemuCmd">qemu-system-i386 -drive format=raw,file=almo7aya.img</code></p>
        <p><a class="dl" id="imgLink" href="/os/almo7aya.img" download>⬇ almo7aya.img</a> <a class="src" id="srcLink" href="/os/7os.asm">view source</a></p>
      </div>
    </section>
  </div>
</div>

<footer class="status">
  <button type="button" id="kGo"><b>F5</b> <span id="goLbl">Break</span></button>
  <button type="button" id="kTrace"><b>F8</b> Trace</button>
  <button type="button" id="kBpx"><b>F9</b> BPX</button>
  <button type="button" id="kReset"><b>F2</b> Reboot</button>
  <button type="button" id="kTurbo" class="turbo on" aria-pressed="true" title="the turbo button: off runs at 4.77 MHz 8086 speed"><b>F7</b> <i></i>TURBO</button>
  <button type="button" id="kSound" aria-pressed="true" title="PC speaker"><b>F6</b> <span id="soundLbl">SPK on</span></button>
  <button type="button" id="kBoot"><b>F12</b> Boot</button>
  <span class="sep"></span>
  <a class="ghs" href="https://github.com/Almo7aya">★ GitHub @Almo7aya</a>
  <a class="opt" href="/posts/">posts</a>
  <a class="opt" href="/about/">about</a>
  <a class="opt" href="/index.xml">rss</a>
  <span class="st" id="state"></span>
</footer>

<script>
import '../lib/cpu8086.js';
import { initDebugger } from '../lib/debugger.js';
initDebugger();
</script>

<style is:global>
@import '../styles/textmode.css';
@import '../styles/debugger.css';
</style>
</body>
</html>
